{
  "name": "veilstrike",
  "private": true,
  "version": "0.1.0",
  "description": "Veilstrike — an offline 1v1 warrior duel game.",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @veilstrike/web",
    "build": "npm run build --workspace @veilstrike/web",
    "preview": "npm run preview --workspace @veilstrike/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "dependencies": {
    "@flayerlabs/gamemode-client": "^0.4.3",
    "@flayerlabs/gamemode-spec": "^0.4.3"
  }
}
